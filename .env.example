# ─── Database (Supabase) ────────────────────────────────────────────────────
# Connection pooler (port 6543, pgbouncer=true) — used at runtime by every
# Vercel serverless function. Supabase Dashboard → Project Settings → Database
# → Connection string → "Transaction" pooler.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — only used locally for `prisma migrate`,
# `bun run db:seed`, `bun run db:fix-enums`. NOT used at runtime, but Vercel
# still needs it set or `prisma generate` can warn/fail on some versions.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── Auth (NextAuth) ─────────────────────────────────────────────────────────
# Must match your deployed Vercel URL exactly, including https://
NEXTAUTH_URL="https://your-app.vercel.app"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-min-32-chars"

# ─── Realtime service (Render) ──────────────────────────────────────────────
# URL of the deployed mini-services/crm-realtime service.
REALTIME_URL="https://your-realtime-service.onrender.com"
# Same URL, exposed to the browser bundle (must be prefixed NEXT_PUBLIC_).
NEXT_PUBLIC_REALTIME_URL="https://your-realtime-service.onrender.com"

# ─── Misc ────────────────────────────────────────────────────────────────
# Optional. Only needed if you use the admin debug endpoint.
ADMIN_DEBUG_KEY=""
