// CRM Prisma Schema — B2B SaaS CRM
// Configured for PostgreSQL (Supabase) with @map annotations for snake_case columns

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL: Supabase connection pooler (port 6543, ?pgbouncer=true) — used at runtime by every serverless function.
  url       = env("DATABASE_URL")
  // DIRECT_URL: Supabase direct connection (port 5432) — used only by `prisma migrate`/`db push`, never at runtime.
  directUrl = env("DIRECT_URL")
}

// ────────────────────────────────────────────────────────────────────────────
// Auth & Users
// ────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         String   @default("SALES_REP") // ADMIN | SALES_MANAGER | SALES_REP
  status       String   @default("ACTIVE")    // ACTIVE | DISABLED
  avatarUrl    String?  @map("avatar_url")
  phone        String?
  jobTitle     String?  @map("job_title")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customers      Customer[]
  leads          Lead[]
  followUps      FollowUp[]
  quotations     Quotation[]
  orders         Order[]
  calls          Call[]
  emailLogs      EmailLog[]
  purchaseOrders PurchaseOrder[]
  activityLogs   ActivityLog[]
  payments       Payment[]
  stockMovements StockMovement[]

  @@map("User")
  @@index([role])
  @@index([status])
}

// ────────────────────────────────────────────────────────────────────────────
// Customers
// ────────────────────────────────────────────────────────────────────────────

model Customer {
  id          String   @id @default(cuid())
  name        String
  company     String
  email       String
  phone       String?
  website     String?
  address     String?
  city        String?
  state       String?
  country     String?
  postalCode  String?  @map("postal_code")
  type        String   @default("BUSINESS") // INDIVIDUAL | BUSINESS
  status      String   @default("ACTIVE")   // ACTIVE | INACTIVE | BLACKLISTED
  industry    String?
  annualRevenue Float?  @map("annual_revenue")
  employees   Int?
  ownerId     String   @map("owner_id")
  owner       User     @relation(fields: [ownerId], references: [id])
  notes       String?
  tags        String?  // comma-separated
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  leads        Lead[]
  followUps    FollowUp[]
  quotations   Quotation[]
  orders       Order[]
  payments     Payment[]
  calls        Call[]
  emailLogs    EmailLog[]

  @@map("Customer")
  @@index([ownerId])
  @@index([status])
  @@index([company])
}

// ────────────────────────────────────────────────────────────────────────────
// Leads
// ────────────────────────────────────────────────────────────────────────────

model Lead {
  id         String   @id @default(cuid())
  name       String
  company    String
  email      String
  phone      String?
  title      String?
  source     String   @default("WEBSITE") // WEBSITE | REFERRAL | COLD_CALL | EVENT | ADS | OTHER
  stage      String   @default("NEW")     // NEW | CONTACTED | QUALIFIED | PROPOSAL | NEGOTIATION | WON | LOST
  status     String   @default("OPEN")    // OPEN | CONVERTED | LOST
  value      Float    @default(0)
  currency   String   @default("USD")
  probability Int     @default(0)         // 0-100
  ownerId    String   @map("owner_id")
  owner      User     @relation(fields: [ownerId], references: [id])
  customerId String?  @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id])
  notes      String?
  expectedCloseDate DateTime? @map("expected_close_date")
  convertedAt DateTime? @map("converted_at")
  lostReason String?  @map("lost_reason")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  followUps  FollowUp[]
  quotations Quotation[]
  calls      Call[]
  emailLogs  EmailLog[]

  @@map("Lead")
  @@index([ownerId])
  @@index([stage])
  @@index([status])
  @@index([customerId])
}

// ────────────────────────────────────────────────────────────────────────────
// Follow-ups
// ────────────────────────────────────────────────────────────────────────────

model FollowUp {
  id          String   @id @default(cuid())
  title       String
  type        String   @default("CALL") // CALL | EMAIL | MEETING | TASK | OTHER
  status      String   @default("PENDING") // PENDING | DONE | SKIPPED | OVERDUE
  priority    String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  dueDate     DateTime @map("due_date")
  completedAt DateTime? @map("completed_at")
  notes       String?
  assigneeId  String   @map("assignee_id")
  assignee    User     @relation(fields: [assigneeId], references: [id])
  customerId  String?  @map("customer_id")
  customer    Customer? @relation(fields: [customerId], references: [id])
  leadId      String?  @map("lead_id")
  lead        Lead?    @relation(fields: [leadId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("FollowUp")
  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
  @@index([leadId])
  @@index([customerId])
}

// ────────────────────────────────────────────────────────────────────────────
// Products & Inventory
// ────────────────────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  name        String
  sku         String   @unique
  description String?
  category    String?  // legacy free-text label — kept for backward compatibility, prefer categoryId
  categoryId  String?  @map("category_id")
  categoryRef Category? @relation(fields: [categoryId], references: [id])
  unit        String   @default("PCS") // PCS | KG | LITER | BOX | SERVICE
  price       Float    @default(0)
  cost        Float    @default(0)
  taxRate     Float    @default(0) @map("tax_rate")
  status      String   @default("ACTIVE") // ACTIVE | DISCONTINUED
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  inventory         Inventory?
  quotationItems    QuotationItem[]
  orderItems        OrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  stockMovements    StockMovement[]

  @@map("Product")
  @@index([category])
  @@index([categoryId])
  @@index([status])
}

// ────────────────────────────────────────────────────────────────────────────
// Categories (dynamic, hierarchical product catalog)
// ────────────────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?  @map("image_url")
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE
  sortOrder   Int      @default(0) @map("sort_order")
  parentId    String?  @map("parent_id")
  parent      Category?  @relation("CategoryToParent", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryToParent")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products    Product[]

  @@map("Category")
  @@index([parentId])
  @@index([status])
  @@index([sortOrder])
}

// ────────────────────────────────────────────────────────────────────────────
// Warehouses (physical or virtual stock locations)
// ────────────────────────────────────────────────────────────────────────────

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique // e.g. "DHK-01"
  address   String?
  city      String?
  isDefault Boolean  @default(false) @map("is_default")
  status    String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  inventory      Inventory[]
  stockMovements StockMovement[]

  @@map("Warehouse")
  @@index([status])
}

model Inventory {
  id            String   @id @default(cuid())
  productId     String   @map("product_id")
  product       Product  @relation(fields: [productId], references: [id])
  warehouseId   String   @map("warehouse_id")
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  quantity      Int      @default(0)
  reserved      Int      @default(0)
  reorderLevel  Int      @default(10) @map("reorder_level")
  location      String?  // free-text shelf/bin label within the warehouse
  lastStockDate DateTime? @map("last_stock_date")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  movements     StockMovement[]

  @@map("Inventory")
  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}

// ────────────────────────────────────────────────────────────────────────────
// Stock Movements (audit trail for every inventory change)
// ────────────────────────────────────────────────────────────────────────────

model StockMovement {
  id             String   @id @default(cuid())
  inventoryId    String   @map("inventory_id")
  inventory      Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  productId      String   @map("product_id")
  product        Product  @relation(fields: [productId], references: [id])
  warehouseId    String   @map("warehouse_id")
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
  type           String   // RECEIVE | ADJUST | SALE | RETURN | DAMAGE | TRANSFER_IN | TRANSFER_OUT | CORRECTION
  quantityChange Int      @map("quantity_change") // signed: +10 or -5
  quantityAfter  Int      @map("quantity_after")
  reason         String?
  reference      String?  // e.g. PO number, order number, or a shared transfer id
  userId         String?  @map("user_id")
  user           User?    @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("StockMovement")
  @@index([inventoryId])
  @@index([productId])
  @@index([warehouseId])
  @@index([type])
  @@index([createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Quotations
// ────────────────────────────────────────────────────────────────────────────

model Quotation {
  id           String   @id @default(cuid())
  number       String   @unique
  customerId   String   @map("customer_id")
  customer     Customer @relation(fields: [customerId], references: [id])
  leadId       String?  @map("lead_id")
  lead         Lead?    @relation(fields: [leadId], references: [id])
  ownerId      String   @map("owner_id")
  owner        User     @relation(fields: [ownerId], references: [id])
  status       String   @default("DRAFT") // DRAFT | SENT | ACCEPTED | REJECTED | EXPIRED | CONVERTED
  subject      String
  subtotal     Float    @default(0)
  taxRate      Float    @default(0) @map("tax_rate")
  taxAmount    Float    @default(0) @map("tax_amount")
  discount     Float    @default(0)
  total        Float    @default(0)
  currency     String   @default("USD")
  validUntil   DateTime? @map("valid_until")
  sentAt       DateTime? @map("sent_at")
  acceptedAt   DateTime? @map("accepted_at")
  notes        String?
  terms        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  items      QuotationItem[]
  order      Order?

  @@map("Quotation")
  @@index([customerId])
  @@index([ownerId])
  @@index([status])
}

model QuotationItem {
  id           String   @id @default(cuid())
  quotationId  String   @map("quotation_id")
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId    String?  @map("product_id")
  product      Product?  @relation(fields: [productId], references: [id])
  description  String
  qty          Float     @default(1)
  unitPrice    Float     @default(0) @map("unit_price")
  discount     Float     @default(0)
  taxRate      Float     @default(0) @map("tax_rate")
  total        Float     @default(0)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("QuotationItem")
  @@index([quotationId])
  @@index([productId])
}

// ────────────────────────────────────────────────────────────────────────────
// Orders
// ────────────────────────────────────────────────────────────────────────────

model Order {
  id            String   @id @default(cuid())
  number        String   @unique
  customerId    String   @map("customer_id")
  customer      Customer @relation(fields: [customerId], references: [id])
  quotationId   String?  @unique @map("quotation_id")
  quotation     Quotation? @relation(fields: [quotationId], references: [id])
  ownerId       String   @map("owner_id")
  owner         User     @relation(fields: [ownerId], references: [id])
  status        String   @default("PENDING") // PENDING | CONFIRMED | PROCESSING | SHIPPED | DELIVERED | CANCELLED | REFUNDED
  paymentStatus String   @default("UNPAID")   @map("payment_status") // UNPAID | PARTIAL | PAID | OVERPAID
  fulfillmentStatus String @default("UNFULFILLED") @map("fulfillment_status") // UNFULFILLED | PARTIAL | FULFILLED
  subtotal      Float    @default(0)
  taxRate       Float    @default(0) @map("tax_rate")
  taxAmount     Float    @default(0) @map("tax_amount")
  discount      Float    @default(0)
  shipping      Float    @default(0)
  total         Float    @default(0)
  paidAmount    Float    @default(0) @map("paid_amount")
  currency      String   @default("USD")
  orderDate     DateTime @default(now()) @map("order_date")
  shippedAt     DateTime? @map("shipped_at")
  deliveredAt   DateTime? @map("delivered_at")
  cancelledAt   DateTime? @map("cancelled_at")
  notes         String?
  shippingAddress String? @map("shipping_address")
  billingAddress  String? @map("billing_address")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  items      OrderItem[]
  payments   Payment[]

  @@map("Order")
  @@index([customerId])
  @@index([ownerId])
  @@index([status])
  @@index([paymentStatus])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?  @map("product_id")
  product     Product? @relation(fields: [productId], references: [id])
  description String
  qty         Float    @default(1)
  unitPrice   Float    @default(0) @map("unit_price")
  discount    Float    @default(0)
  taxRate     Float    @default(0) @map("tax_rate")
  total       Float    @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("OrderItem")
  @@index([orderId])
  @@index([productId])
}

// ────────────────────────────────────────────────────────────────────────────
// Payments
// ────────────────────────────────────────────────────────────────────────────

model Payment {
  id          String   @id @default(cuid())
  number      String   @unique
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id])
  customerId  String   @map("customer_id")
  customer    Customer @relation(fields: [customerId], references: [id])
  ownerId     String   @map("owner_id")
  owner       User     @relation(fields: [ownerId], references: [id])
  amount      Float
  currency    String   @default("USD")
  method      String   @default("BANK_TRANSFER") // CASH | CREDIT_CARD | BANK_TRANSFER | PAYPAL | CHECK | OTHER
  status      String   @default("PENDING") // PENDING | COMPLETED | FAILED | REFUNDED
  reference   String?
  paidAt      DateTime? @map("paid_at")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")


  @@map("Payment")
  @@index([orderId])
  @@index([customerId])
  @@index([status])
}

// ────────────────────────────────────────────────────────────────────────────
// Purchase Orders
// ────────────────────────────────────────────────────────────────────────────

model PurchaseOrder {
  id          String   @id @default(cuid())
  number      String   @unique
  supplier    String
  supplierEmail String? @map("supplier_email")
  supplierPhone String? @map("supplier_phone")
  ownerId     String   @map("owner_id")
  owner       User     @relation(fields: [ownerId], references: [id])
  status      String   @default("DRAFT") // DRAFT | SENT | PARTIAL | RECEIVED | CANCELLED
  subtotal    Float    @default(0)
  taxAmount   Float    @default(0) @map("tax_amount")
  total       Float    @default(0)
  currency    String   @default("USD")
  expectedDate DateTime? @map("expected_date")
  receivedAt  DateTime? @map("received_at")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items      PurchaseOrderItem[]

  @@map("PurchaseOrder")
  @@index([ownerId])
  @@index([status])
  @@index([supplier])
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String   @map("purchase_order_id")
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String?  @map("product_id")
  product         Product? @relation(fields: [productId], references: [id])
  description     String
  qty             Float    @default(1)
  unitPrice       Float    @default(0) @map("unit_price")
  total           Float    @default(0)
  receivedQty     Float    @default(0) @map("received_qty")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("PurchaseOrderItem")
  @@index([purchaseOrderId])
  @@index([productId])
}

// ────────────────────────────────────────────────────────────────────────────
// Communications
// ────────────────────────────────────────────────────────────────────────────

model Call {
  id          String   @id @default(cuid())
  type        String   @default("CALL") // CALL | MESSAGE
  direction   String   @default("OUTBOUND") // INBOUND | OUTBOUND
  status      String   @default("COMPLETED") // COMPLETED | MISSED | FAILED | SCHEDULED
  duration    Int      @default(0) // seconds
  subject     String?
  notes       String?
  customerId  String?  @map("customer_id")
  customer    Customer? @relation(fields: [customerId], references: [id])
  leadId      String?  @map("lead_id")
  lead        Lead?    @relation(fields: [leadId], references: [id])
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id])
  startedAt   DateTime @default(now()) @map("started_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("Call")
  @@index([customerId])
  @@index([leadId])
  @@index([userId])
  @@index([type])
}

model EmailLog {
  id          String   @id @default(cuid())
  to          String
  from        String
  cc          String?
  bcc         String?
  subject     String
  body        String
  status      String   @default("SENT") // SENT | DELIVERED | OPENED | FAILED | BOUNCED
  customerId  String?  @map("customer_id")
  customer    Customer? @relation(fields: [customerId], references: [id])
  leadId      String?  @map("lead_id")
  lead        Lead?    @relation(fields: [leadId], references: [id])
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id])
  sentAt      DateTime @default(now()) @map("sent_at")
  openedAt    DateTime? @map("opened_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("EmailLog")
  @@index([customerId])
  @@index([leadId])
  @@index([userId])
  @@index([status])
}

// ────────────────────────────────────────────────────────────────────────────
// Activity Log (audit trail)
// ────────────────────────────────────────────────────────────────────────────

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  action     String   // CREATE | UPDATE | DELETE | LOGIN | LOGOUT | CONVERT | STATUS_CHANGE | ...
  entity     String   // CUSTOMER | LEAD | ORDER | ...
  entityId   String   @map("entity_id")
  entityName String?  @map("entity_name")
  summary    String
  metadata   String?  // JSON string
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("ActivityLog")
  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Settings (key-value store)
// ────────────────────────────────────────────────────────────────────────────

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("GENERAL")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("Setting")
}
